# Copy this file to .env, then adjust the values for your machine.
# .env is ignored by git because paths and runtime settings are machine-specific.

# Media source: use local or nas.
VIDEO_SOURCE=local

# Local media folder used when VIDEO_SOURCE=local.
VIDEO_ROOT=./videos

# Host path used by the API when VIDEO_SOURCE=nas.
# The NAS mount must be readable by the user running npm start.
NAS_VIDEO_ROOT=/Volumes/video-nfs

# Optional automatic NFS mount settings used by npm start in NAS mode.
# npm start will ask for your Mac administrator password through sudo.
# Replace the server, export, and mount path with your own values.
# NAS_MOUNT_SOURCE=192.168.5.110:/volume1/video
# NAS_MOUNT_PATH=/Volumes/video-nfs
# NAS_MOUNT_OPTIONS=resvport,rw,bg,hard,intr,rsize=1048576,wsize=1048576

# Number of different video files indexed concurrently.
SCAN_CONCURRENCY=4

# Number of persistent ExifTool workers used for metadata reads.
# Keep this at or below SCAN_CONCURRENCY; 4 is a good starting point for NAS scans.
EXIFTOOL_CONCURRENCY=4

# Keep the catalog separate from the media source.
DATABASE_PATH=./data/bright-video.db
PORT=4318
