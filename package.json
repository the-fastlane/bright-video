{
  "name": "bright-video",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file=.env server/mount-nas.mjs && node --env-file=.env server/start.mjs",
    "start:production": "npm run build && node --env-file=.env server/mount-nas.mjs && NODE_ENV=production node --env-file=.env server/index.mjs",
    "api": "node --env-file=.env server/index.mjs",
    "start:local": "node --env-file=.env server/index.mjs",
    "test:reindex": "node server/reindex-smoke.mjs",
    "benchmark": "node --env-file=.env server/benchmark-scan.mjs",
    "start:ui": "PATH=\"$HOME/.nvm/versions/node/v22.22.3/bin:$PATH\" ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@rapideditor/country-coder": "^5.6.1",
    "all-the-cities": "^3.1.0",
    "chokidar": "^5.0.0",
    "exiftool-vendored": "^38.0.1",
    "ffmpeg-static": "^5.3.0",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "concurrently": "^9.2.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
